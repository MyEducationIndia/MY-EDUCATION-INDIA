FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install PostgreSQL client tools (pg_dump, pg_restore, psql) for transaction-safe DB backups
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root enterprise user
RUN groupadd -r meiuser && useradd -r -g meiuser -d /app -s /sbin/nologin meiuser

COPY backend/pyproject.toml /app/pyproject.toml
RUN pip install --upgrade pip && pip install .

COPY backend /app

RUN mkdir -p /app/app/logs /app/backups && chown -R meiuser:meiuser /app

USER meiuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers"]
